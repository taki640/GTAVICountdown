<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GTA VI Countdown</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="GTAVICountdown\**" />
    <EmbeddedResource Remove="GTAVICountdown\**" />
    <None Remove="GTAVICountdown\**" />
    <Page Remove="GTAVICountdown\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\icon.png" />
    <None Remove="Assets\img_gta_vi_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="Source\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\img_gta_vi_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Source\Preferences.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Preferences.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Source\Preferences.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Preferences.Designer.cs</LastGenOutput>
      <CustomToolNamespace>GTAVICountdown</CustomToolNamespace>
    </None>
  </ItemGroup>

</Project>
